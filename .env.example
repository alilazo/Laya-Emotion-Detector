LAYA_CHECKPOINT=typed-decisions
LAYA_DEVICE=cpu
LAYA_ENABLED=1
LAYA_WARMUP=1
EMOTION_NEUTRAL_THRESHOLD=10
EMOTION_MIXED_THRESHOLD=60
EMOTION_HIGH_THRESHOLD=70
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=lfm2.5-8b-a1b:32k
EMOTION_VERIFIER_MODEL=qwen3.6-35b-a3b:ud-iq3-s
OLLAMA_TIMEOUT_SECONDS=180
# Optional. Otherwise a random key is printed with the local URL on startup.
# LOCAL_ACCESS_TOKEN=
